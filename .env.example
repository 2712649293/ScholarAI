# 复制到 backend/.env；字段以 backend/app/config.py 为准，进程环境变量优先。
# LLM：统一使用 OpenAI 兼容接口；研究模式需要工具调用与结构化输出。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
# Optional OpenAI-compatible reasoning control; Qwen models default to none.
# LLM_REASONING_EFFORT=none
LLM_TIMEOUT_SECONDS=60

# 单篇论文深度分析：章节提取及论文级汇总使用小模型；综述生成/审校使用主模型。
# 留空 SMALL_LLM_MODEL 时使用主模型；同一 API 只需填写小模型名称。
SMALL_LLM_MODEL=
SMALL_LLM_BASE_URL=
SMALL_LLM_API_KEY=
# URL 留空复用 LLM_BASE_URL；同一 URL 下 Key 留空复用 LLM_API_KEY。
# 独立 URL 必须显式填写 Key，无鉴权服务可填 none；调用失败不切回主模型。
# 独立推理参数，不继承主模型；Qwen 小模型默认 none。
SMALL_LLM_REASONING_EFFORT=

# 论文检索与 PDF 下载统一通过 paper-search-mcp MCP 服务。
# 默认使用后端依赖中安装的 paper-search-mcp；自定义部署可替换命令和参数。
PAPER_SEARCH_MCP_COMMAND=paper-search-mcp
PAPER_SEARCH_MCP_ARGS=
PAPER_SEARCH_MCP_TIMEOUT_SECONDS=120

# Embedding：应用强制离线加载 BGE，本地首次使用需预下载；步骤见 README。
EMBEDDING_PROVIDER=bge             # bge | openai | qwen | remote | openai-compatible
BGE_MODEL=BAAI/bge-small-zh-v1.5
BGE_DEVICE=cpu                     # cpu | cuda | mps
# 远程服务：将上方 provider 改为 remote，取消注释并填写以下字段。
# 基础 URL 通常到 /v1，不含 /embeddings。
# EMBEDDING_API_KEY=your-key
# EMBEDDING_BASE_URL=https://your-embedding-host/v1
# EMBEDDING_MODEL=your-embedding-model
# Key 别名：OPENAI_API_KEY / DASHSCOPE_API_KEY；URL：OPENAI_BASE_URL；模型：OPENAI_EMBEDDING_MODEL。
# 更换模型名后，下次启动会删除不匹配的知识库、向量和关联 PDF，需重新上传。
EMBEDDING_MAX_INPUT_TOKENS=512      # 本地还会遵守模型实际 tokenizer/max_seq_length

# 可选图片描述：留空 URL 即跳过，不影响普通论文索引；不复用 LLM 配置。
# URL 到 /v1；代码追加 /responses 或 /chat/completions。
VISION_BASE_URL=
VISION_MODEL=gpt-6.1-sol
VISION_API_KEY=
VISION_API_STYLE=responses         # responses | chat_completions
VISION_TIMEOUT_SECONDS=45
VISION_DOCUMENT_BUDGET_SECONDS=180
VISION_MAX_CONCURRENCY=2
VISION_MAX_IMAGES_PER_DOC=30

# 可选外部重排：完整端点，例如 https://your-host/v1/rerank。
# 请求 query/documents/top_n/model(可选)，响应 results:[{index,relevance_score}]。
# 留空或调用失败时保留 RRF 顺序；此协议独立于 OpenAI Chat API。
RERANK_ENDPOINT=
RERANK_MODEL=
RERANK_API_KEY=
RERANK_TIMEOUT_SECONDS=15
RETRIEVAL_BRANCH_LIMIT=30
RERANK_CANDIDATE_LIMIT=40
RAG_CONTEXT_TOKENS=4000
CHUNK_MIN_TOKENS=120
CHUNK_TARGET_TOKENS=300
CHUNK_MAX_TOKENS=450
CHUNK_OVERLAP_TOKENS=60

# Storage：相对路径基于后端工作目录；Compose 覆盖这些路径至 /app/data。
DATABASE_URL=sqlite:///./data/scholarai.db
PAPER_STORAGE_DIR=./data/papers
REPORTS_DIR=./data/reports
CHROMA_PERSIST_DIR=./data/chroma
UPLOAD_DIR=./data/uploads
UPLOAD_MAX_SIZE_MB=50
UPLOAD_MAX_PAGES=500

# Observability
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=scholarai
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173"]

# 以下字段已声明但尚未接入执行逻辑，设置后不会产生相应效果。
# LLM_PROVIDER=deepseek             # 不切换客户端；用 LLM_BASE_URL / LLM_MODEL 选择服务
# API_PORT=8000                     # 实际端口由 Uvicorn 启动参数决定
# RESEARCH_TIMEOUT_SECONDS=300      # 未实现研究总超时
# LANGCHAIN_SAMPLE_RATE=1.0          # 未实现 tracing 采样率
