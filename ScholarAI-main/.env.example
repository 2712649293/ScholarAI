# LLM
LLM_PROVIDER=deepseek              # deepseek | openai | anthropic | ollama
# LLM_API_KEY 留空会导致聊天和研究请求失败；请填写真实 API Key。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=60             # 单次 LLM 调用的硬超时

# Embedding（dev 用本地 BGE；也支持 OpenAI-compatible 远程服务）
# ⚠️ 切换 embedding provider 或模型后，服务下次启动会自动删除使用旧模型的知识库、向量和关联上传文件，请先备份。
EMBEDDING_PROVIDER=bge             # bge | openai | qwen | remote
# 远程 embedding（EMBEDDING_BASE_URL 通常填写到 /v1；qwen 可填 DashScope 兼容地址）
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-3-small
BGE_MODEL=BAAI/bge-small-zh-v1.5
BGE_DEVICE=cpu                     # cpu | cuda | mps
# 国内网络下设 HF_ENDPOINT 走 hf-mirror.com 下载模型；已下载后置 OFFLINE 跳过检查
# HF_ENDPOINT=https://hf-mirror.com
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1
# 兼容旧配置：OPENAI_API_KEY / OPENAI_BASE_URL / OPENAI_EMBEDDING_MODEL
# 也可作为上面三个 EMBEDDING_* 变量的别名；Qwen 可使用 DASHSCOPE_API_KEY。

# Storage
DATABASE_URL=sqlite:///./data/scholarai.db
PAPER_STORAGE_DIR=./data/papers
REPORTS_DIR=./data/reports
CHROMA_PERSIST_DIR=./data/chroma
UPLOAD_DIR=./data/uploads
UPLOAD_MAX_SIZE_MB=50
UPLOAD_MAX_PAGES=500

# Observability
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=scholarai
LANGCHAIN_SAMPLE_RATE=1.0          # 生产建议 0.1 (10%)
LOG_LEVEL=INFO

# App
CORS_ORIGINS=["http://localhost:5173"]
API_PORT=8000
RESEARCH_TIMEOUT_SECONDS=300       # 单次研究请求的总超时
